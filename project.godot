; Engine Configuration File.
; Godot version: 4.x
; Sea Trader — Phase 01 Foundation

[application]
config/name="Sea Trader"
config/description="Offline top-down maritime trading game"
run/main_scene="res://scenes/game/main.tscn"
config/features=PackedStringArray("4.2", "Mobile")
boot_splash/bg_color=Color(0.141176, 0.141176, 0.141176, 1)

[autoload]
GameState="*res://autoloads/game_state.gd"
EventBus="*res://autoloads/event_bus.gd"
SaveSystem="*res://autoloads/save_system.gd"

[display]
window/size/viewport_width=1080
window/size/viewport_height=1920
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[layer_names]
2d_physics/layer_1="ship"
2d_physics/layer_2="island"
2d_physics/layer_3="port"
2d_physics/layer_4="hazard"

[rendering]
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
